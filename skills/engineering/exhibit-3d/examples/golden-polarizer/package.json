{
  "name": "polarizer-bench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "typecheck": "tsc --noEmit",
