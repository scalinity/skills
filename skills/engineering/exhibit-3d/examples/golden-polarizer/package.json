  },
  "dependencies": {
    "three": "0.186.1",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource/dm-mono": "5.3.0"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  }
}
